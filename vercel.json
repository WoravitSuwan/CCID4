{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index?__path=$1" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,docker/**,static/src/**,media/**,data/**,.venv/**,node_modules/**}"
    }
  }
}
