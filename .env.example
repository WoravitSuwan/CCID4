# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit .env)
DJANGO_SECRET_KEY=เปลี่ยนเป็นข้อความสุ่มยาวๆ-อย่างน้อย-50-ตัวอักษร
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# ถ้าเปิดผ่าน IP ให้ใส่ เช่น http://192.168.1.10:8000 / ถ้าขึ้นเซิร์ฟเวอร์ผ่านโดเมน ใส่ เช่น https://summons.example.go.th
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# ตั้งเป็น 1 เมื่อเปิดใช้ผ่าน HTTPS (reverse proxy ส่ง X-Forwarded-Proto) เพื่อให้คุกกี้ล็อกอินส่งเฉพาะ HTTPS
DJANGO_HTTPS=0

POSTGRES_DB=summons
POSTGRES_USER=summons
POSTGRES_PASSWORD=เปลี่ยนรหัสผ่านฐานข้อมูล

# บัญชีผู้ดูแลระบบที่สร้างให้อัตโนมัติครั้งแรก
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=เปลี่ยนรหัสผ่านผู้ดูแล

# ระบบนี้ใช้เฉพาะหน่วยนี้: นำเข้าทะเบียนเฉพาะคดีที่ "หน่วยที่รับผิดชอบ" ตรงกับชื่อนี้
OWN_UNIT=กก.1 บก.สอท.4

# ลบไฟล์ที่ส่งออกหลังกี่วัน (ค่าเริ่มต้น; แก้ได้ในหน้าตั้งค่า)
MEDIA_RETENTION_DAYS=30
# ส่งออกเกินกี่ฉบับจึงทำงานเบื้องหลัง
EXPORT_ASYNC_THRESHOLD=20
WEB_PORT=8000

# บอท LINE (ไม่บังคับ): เว้นว่างไว้ = ระบบไม่ติดต่อภายนอกเลย  ดู README หัวข้อ "บอท LINE"
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
